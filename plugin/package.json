{
  "name": "my-meme-dsh-plugin",
  "version": "0.1.0",
  "description": "DeepSeek Harness tools for searching and generating memes and reaction GIFs",
  "type": "module",
  "main": "lib/meme-plugin.js",
  "types": "lib/meme-plugin.d.ts",
  "exports": {
    ".": {
      "types": "./lib/meme-plugin.d.ts",
      "default": "./lib/meme-plugin.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc --project tsconfig.json",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.3-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.3-alpha.1",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
